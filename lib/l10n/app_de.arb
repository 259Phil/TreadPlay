  "msgGiftKolk": "{n, select, 0{Glänzte am Wegrand – jetzt hängt’s an deiner Leine.} 1{Ein Kupferbeutel! Ich hab ihn nicht geklaut. Fast.} 2{Für dich gefunden, für dich gebracht.} 3{Kupfer klimpert so schön. Er hängt schon an der Leine.} 4{Bleib im Takt, dann bring ich mehr.} 5{Den hab ich über drei Dächer getragen.} other{Glänzte am Wegrand – jetzt hängt’s an deiner Leine.}}",
  "msgTaskKolk": "{n, select, 0{Kraa! Ich hab einen Auftrag für dich.} 1{Willst du was verdienen? Hör zu.} 2{Ein Rabe vergisst nie – auch keinen Lohn.} 3{Mach das, und ich lass was Glänzendes da.} 4{Kleine Wette: Schaffst du das?} 5{Kraa! Hier eine Aufgabe, keine Eile.} other{Kraa! Ich hab einen Auftrag für dich.}}",
  "msgGreetFlimm": "{n, select, 0{Ein Lichtlein flackert – Glimmsel ist da.} 1{Sssst … ich bin deinem Licht gefolgt.} 2{Guten Abend, auch wenn’s Tag ist.} 3{Glimmsel hier, ganz leise.} 4{Deine Schritte leuchten heute.} 5{Ich kam mit dem Wind.} other{Ein Lichtlein flackert – Glimmsel ist da.}}",
  "msgGiftFlimm": "{n, select, 0{Ein türkiser Beutel, so selten wie ein klarer Himmel.} 1{Ich hab ihn sanft an deine Leine gehängt.} 2{Er schimmert wie meine Laterne. Für dich.} 3{Nicht jeder bekommt so einen. Du schon.} 4{Lauf ihn warm, dann zeigt er sein Licht.} 5{Den hat mir der Abendwind gegeben.} other{Ein türkiser Beutel, so selten wie ein klarer Himmel.}}",
  "msgTaskFlimm": "{n, select, 0{Hilfst du mir, mein Licht zu nähren?} 1{Ein kleiner Wunsch, ganz ohne Frist.} 2{Wenn du magst, zeig ich dir den Weg.} 3{Folge diesem Auftrag wie einem Glühwürmchen.} 4{Tu dies, und meine Laterne lohnt es dir.} 5{Nur ein Lichtfaden von einer Aufgabe.} other{Hilfst du mir, mein Licht zu nähren?}}",
  "msgGreetVesper": "{n, select, 0{Sei gegrüßt. Sternuh ist herabgestiegen.} 1{Die Sterne sagten mir, wo du läufst.} 2{Selten komme ich. Heute komme ich zu dir.} 3{Verneige dich nicht – lauf lieber weiter.} 4{Der Nachthimmel schickt mich.} 5{Ein seltener Abend für einen seltenen Gast.} other{Sei gegrüßt. Sternuh ist herabgestiegen.}}",
  "msgGiftVesper": "{n, select, 0{Ein nachtblauer Beutel – der seltenste von allen.} 1{Aus der Schatzkammer der Sterne, an deine Leine.} 2{Trag ihn mit Stolz. Er hängt schon.} 3{Dein Glück hat mich gerufen. Hier ist sein Lohn.} 4{Nur wenige sehen diesen Samt. Du gehörst dazu.} 5{Lauf ihn warm – er birgt Großes.} other{Ein nachtblauer Beutel – der seltenste von allen.}}",
  "msgTaskVesper": "{n, select, 0{Ich stelle dir eine würdige Aufgabe.} 1{Zeig mir dein Durchhalten.} 2{Ein Auftrag der Sterne, ohne Eile.} 3{Vollende dies, und der Himmel lohnt es dir.} 4{Große Schritte für einen großen Lohn.} 5{Ich warte. Geduld ist meine Stärke.} other{Ich stelle dir eine würdige Aufgabe.}}",
  "msgLineFull": "{n, select, 0{Oh – deine Leine ist ja voll!} 1{Kein Haken mehr frei, schade.} 2{Deine Leine ist voll, ich nehm ihn wieder mit.} 3{Hm, alles belegt. Öffne ein paar Beutel!} 4{Volle Leine! Ich komme ein andermal.} 5{Da hängt schon alles voll – nächstes Mal.} other{Oh – deine Leine ist ja voll!}}",
  "msgLineDone": "{n, select, 0{Geschafft! Hier ist dein Lohn.} 1{Auftrag erfüllt – gut gelaufen!} 2{Wie versprochen: dein Lohn.} 3{Das hast du fein gemacht.} 4{Erledigt! Der Lohn liegt im Vorrat.} 5{Bravo – ich wusste, du schaffst das.} other{Geschafft! Hier ist dein Lohn.}}",
